# OpenAI API 키 — 궁합 분석에 사용
OPENAI_API_KEY=
# (선택) 모델, 기본 gpt-5.4-mini
OPENAI_MODEL=
# (선택) OpenAI 호환 엔드포인트. Vercel AI Gateway 등으로 교체할 때 지정
OPENAI_BASE_URL=

# Google AdSense (선택) — 값이 없으면 광고 영역은 렌더되지 않음
# 게시자 ID (예: ca-pub-0000000000000000)
NEXT_PUBLIC_ADSENSE_CLIENT=
# 스텝1 고정 배너 광고 단위 slot ID
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=
# 분석중(로딩) 화면 디스플레이 광고 단위 slot ID
NEXT_PUBLIC_ADSENSE_SLOT_LOADING=
# 콘텐츠 페이지(/mbti, /pair) 본문 중간 광고 단위 slot ID (AdSense "인아티클" 타입으로 생성)
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=

# Google Analytics (선택) — GA4 측정 ID (예: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# 어드민(/admin) 접속 비밀번호 — 미설정 시 어드민은 항상 잠긴다
ADMIN_PASSWORD=

# Supabase — 분석 결과 저장 및 공유 링크 재현
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role 키는 서버 전용 비밀 (절대 클라이언트 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=

# 쿠팡 파트너스 (선물 딥링크 생성 — 로컬 배치 전용, 런타임 미사용)
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_SUB_ID=scoregift

# 파트너스 승인 전 심사용: 1 이면 제휴 링크 대신 일반 쿠팡 검색 링크로 버튼 노출
NEXT_PUBLIC_GIFT_PREVIEW=
